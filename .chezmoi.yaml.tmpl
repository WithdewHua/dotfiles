{{/* git user.email */}}
{{- $email := promptStringOnce . "email" "Email: " -}}

{{/* git user.name */}}
{{- $name := promptStringOnce . "name" "Name: " -}}

{{/* editor */}}
{{- $editor := "vi" -}}
{{- if lookPath "nvim" -}}
{{-   $editor = "nvim" -}}
{{- else if lookPath "vim" -}}
{{-   $editor = "vim" -}}
{{- else if eq .chezmoi.os "windows" -}}
{{/* Windows has no vi; the winget step installs Neovim, so nvim is the right default. */}}
{{-   $editor = "nvim" -}}
{{- end -}}

{{/* boolean flag */}}
{{- $work_machine := promptBoolOnce . "work_machine" "Company's computer" -}}

{{- $config_python_format_tools := promptBoolOnce . "config_python_format_tools" "Config python formatting tools" -}}

{{- $install_more_packages := promptBoolOnce . "install_more_packages" "Install more packages" -}}

{{/* gpg command: chezmoi runs this for the encrypted files. The Windows GnuPG
     installer does not always put gpg on PATH, so fall back to its install dirs. */}}
{{- $gpg_command := "gpg" -}}
{{- $gpg_path := lookPath "gpg" -}}
{{- if not $gpg_path -}}
{{-   range $candidate := list "C:\\Program Files (x86)\\GnuPG\\bin\\gpg.exe" "C:\\Program Files\\GnuPG\\bin\\gpg.exe" -}}
{{-     if and (eq $gpg_command "gpg") (stat $candidate) -}}
{{-       $gpg_command = $candidate -}}
{{-       $gpg_path = $candidate -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{/* Which GPG-encrypted personal files this machine takes. One multi-select prompt
     listing the actual paths, so a second machine can take the Pi provider keys and
     the SSH keys while leaving its own Claude/opencode settings alone. Defaults to
     the Pi provider keys, which is what a machine needs for Pi to reach a provider. */}}
{{- $personal := promptMultichoiceOnce . "personal" "Personal, GPG-encrypted files to manage here" (list ".pi/agent/models.json" ".ssh/config" ".claude" ".config/opencode") (list ".pi/agent/models.json") -}}
{{- $needs_gpg := ne (len $personal) 0 -}}

{{- $gpg_encrypt_key_id := "" -}}
{{- $gpg_sign_key_id := "" -}}
{{- if $needs_gpg -}}
{{-     if not $gpg_path -}}
{{-         warnf "gpg was not found on PATH; the encrypted files will fail to decrypt. Install GnuPG (winget install --id GnuPG.GnuPG --exact) and re-run chezmoi init." -}}
{{-     end -}}
{{-     $gpg_encrypt_key_id = promptStringOnce . "gpg_encrypt_key_id" "GPG Key ID for encryption: " -}}
{{-     $gpg_sign_key_id = promptStringOnce . "gpg_sign_key_id" "GPG Key ID for signing: " -}}
{{- end -}}

{{- $is_desktop := promptBoolOnce . "is_desktop" "Desktop?" -}}

{{/* zsh is not managed on Windows, so do not ask about its prompt theme. */}}
{{- $zsh_theme := "pure" -}}
{{- if ne .chezmoi.os "windows" -}}
{{-   $zsh_theme = promptStringOnce . "zsh_theme" "Zsh theme(pure/starship): " -}}
{{- end -}}


data:
  email: {{ $email | quote }}
  name: {{ $name | quote }}
  editor: {{ $editor }}
  config_python_format_tools: {{ $config_python_format_tools }}
  install_more_packages: {{ $install_more_packages }}
  is_desktop: {{ $is_desktop }}
  personal: {{ $personal | toJson }}
  needs_gpg: {{ $needs_gpg }}
  zsh_theme: {{ $zsh_theme }}
  work_machine: {{ $work_machine }}
  gpg_encrypt_key_id: {{ $gpg_encrypt_key_id | quote }}
  gpg_sign_key_id: {{ $gpg_sign_key_id | quote }}

diff:
  exclude:
    - scripts
encryption: "gpg"
gpg:
  command: {{ $gpg_command | quote }}
  recipient: {{ $gpg_encrypt_key_id }}
  args:
    - "--trust-model"
    - "always"
