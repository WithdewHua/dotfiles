{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/main/schemas/aft.schema.json",
  // 不接管 Pi 原生 read/write/edit/grep，避免与 SoL-Pi (then_run) 和 pi-fff 冲突
  "hoist_builtin_tools": false,
  // 禁用 AFT 的 bash 接管，保持原生终端与现有插件环境
  "bash": false,
  // 启用代码健康度与问题检查
  "inspect": {
    "enabled": true
  }
}
