{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "allow_home_project": true,
  "execute_threshold_tokens": {
    // 取向：注意力优先。阈值 ≈ 模型“仍能稳定保持注意力”的长度，而不是窗口余量或单价能撑到的长度。
    // 经验区间（标称窗口占比）：flagship 旗舰 24–30%，flash/轻量家族 23–28%；MC 会把超过 90%×可用窗口的值 clamp 并告警。
    // 为什么要压而不是抬：MC 每回合渲染的历史块预算 = 可用窗口 × 阈值% × history_budget_percentage(0.15)，
    // 阈值一抬，原始尾巴和结构化历史块会一起变长，两处同时稀释注意力。
    "default": 150000,
    // 272k 窗口 (gpt-5.6-sol/terra/luna)；可用 204k，74% → 150k；距 95% 应急墙 (193.8k) 余 44k ≈ 3× 实测 p99 单回合增长 (14.9k)
    "gpt-5.6": 150000,
    // 1.05M 窗口 (可用 922k)，272k 输入处 2× 阶梯：astra 单价 10/1.0，255k = 24% 窗口，同时留 17k 阶梯余量
    "gpt-6-astra": 255000,
    // sol/luna：320k ≈ 30% 窗口 (过 272k 阶梯那一小段单价翻倍，但绝对额小)
    "gpt-6": 320000,
    "gpt-6.1": 320000,
    // 500k 窗口 (grok-4.6/4.7, 可用 375k)：160k = 32% 窗口，距 200k 阶梯余 40k
    "grok": 160000,
    // 无阶梯加价的 1M 级窗口模型：300k = 30% 窗口 (可用 872k)
    "claude": 300000,
    // flash/轻量家族的长上下文能力最可疑，统一压到 23–28% 窗口：
    // gemini-3.8-flash-high 240k = 23% (可用 983k)
    "gemini": 240000,
    // glm-5.3 / glm-5.3-flash 240k = 24% (可用 869k)
    "glm": 240000,
    // qwen3.8-flash 240k = 24% (可用 869k)
    "qwen3.8": 240000,
    "qwen": 240000,
    // deepseek-flash 280k = 28% (可用 750k)
    "deepseek": 280000
  },
  "historian": {
    "pi": {
      "model": "magpie/deepseek-flash",
      "fallback_models": [
        "magpie/gemini-3.8-flash-high",
        "magpie/gpt-6-luna"
      ]
    }
  },
  "dreamer": {
    "pi": {
      "model": "magpie/deepseek-flash",
      "fallback_models": [
        "magpie/gemini-3.8-flash-high",
        "magpie/gpt-6-luna"
      ]
    }
  },
  "embedding": {
    "provider": "local"
  },
  // cache_ttl = MC 假设「提供方缓存还热」的时长(只影响 MC 何时愿意改写前缀,不改提供方行为):
  //   【有官方文档】claude   5m  — Anthropic 默认档;已核实:你的写入溢价 1.25× 正好是 5m 档,
  //                                且所有历史会话都没有 1h 写入(cacheWrite1h),说明没在用 1h 扩展
  //                gpt     30m  — GPT-5.6+ 的 prompt_cache_options.ttl 唯一支持值=默认值,
  //                                "缓存前缀在最近一次写入或复用后 30 分钟内可复用"
  //                qwen     5m  — 显式缓存有效期 5 分钟
  //   【无文档,按实测】grok  10m  — 实测 >5m 41%、>10m 31%、>30m 0%
  //                    gemini 5m  — 隐式缓存无 TTL 承诺;实测 >5m 17%、>10m 0%
  //                    glm    5m  — 实测 >5m 15%、>10m 0%
  //   【动态/尽力而为】deepseek 45m — 实测 <30m 99.4% 命中, 36m 99.8%, 51m 失效; 设为 45m 平衡保前缀与防冷重算
  "cache_ttl": {
    "default": "5m",
    "gpt": "30m",
    "deepseek": "45m",
    "grok": "10m"
  },
  "pi": {
    "subagent_extensions": []
  }
}
