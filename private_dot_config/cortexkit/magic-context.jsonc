{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "allow_home_project": true,
  "historian": {
    "pi": {
      "model": "kekulv/gemini-3.8-flash-high",
      "fallback_models": [
        "kekulv/gpt-5.6-luna",
        "kekulv/deepseek-v4-flash"
      ]
    }
  },
  "dreamer": {
    "pi": {
      "model": "kekulv/gemini-3.8-flash-high",
      "fallback_models": [
        "kekulv/gpt-5.6-luna"
      ]
    }
  },
  "embedding": {
    "provider": "local"
  },
  "cache_ttl": {
    "default": "5m",
    "kekulv/claude": "5m",
    "kekulv/gpt": "30m",
    "kekulv/gemini": "10m",
    "kekulv/deepseek": "24h",
    "kekulv/glm": "12h",
    "kekulv/grok": "1h",
    "kekulv/qwen": "5m"
  },
  "pi": {
    "subagent_extensions": []
  }
}
