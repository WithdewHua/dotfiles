{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "allow_home_project": true,
  "execute_threshold_tokens": {
    "default": 150000,
    // 272k 窗口模型 (gpt-5.6-sol / terra / luna): 约 64% 处触发, 留足 97k 缓冲区
    "kekulv/gpt-5.6": 175000,
    // 1.05M 窗口模型 (gpt-6-astra): >272k 阶梯翻倍加价, 设为 250k 避免触发加价
    "kekulv/gpt-6": 250000,
    // 500k 窗口模型 (grok-4.6): >200k 阶梯翻倍加价, 设为 180k 避免触发加价
    "kekulv/grok": 180000,
    // 1M/1.05M 窗口且无阶梯加价模型:
    "kekulv/gemini": 250000,
    "kekulv/deepseek": 280000,
    "kekulv/claude": 250000,
    "kekulv/glm": 250000,
    "kekulv/qwen": 250000
  },
  "historian": {
    "pi": {
      "model": "kekulv/gemini-3.8-flash-high",
      "fallback_models": [
        "kekulv/gpt-5.6-luna",
        "kekulv/deepseek-v4-flash"
      ]
    }
  },
  "dreamer": {
    "pi": {
      "model": "kekulv/gemini-3.8-flash-high",
      "fallback_models": [
        "kekulv/gpt-5.6-luna"
      ]
    }
  },
  "embedding": {
    "provider": "local"
  },
  // cache_ttl = MC 假设「提供方缓存还热」的时长(只影响 MC 何时愿意改写前缀,不改提供方行为):
  //   【有官方文档】claude   5m  — Anthropic 默认档;已核实:你的写入溢价 1.25× 正好是 5m 档,
  //                                且所有历史会话都没有 1h 写入(cacheWrite1h),说明没在用 1h 扩展
  //                gpt     30m  — GPT-5.6+ 的 prompt_cache_options.ttl 唯一支持值=默认值,
  //                                "缓存前缀在最近一次写入或复用后 30 分钟内可复用"
  //                qwen     5m  — 显式缓存有效期 5 分钟
  //   【无文档,按实测】grok  10m  — 实测 >5m 41%、>10m 31%、>30m 0%
  //                    gemini 5m  — 隐式缓存无 TTL 承诺;实测 >5m 17%、>10m 0%
  //                    glm    5m  — 实测 >5m 15%、>10m 0%
  //   【动态/尽力而为】deepseek 45m — 实测 <30m 99.4% 命中, 36m 99.8%, 51m 失效; 设为 45m 平衡保前缀与防冷重算
  "cache_ttl": {
    "default": "5m",
    "kekulv/gpt": "30m",
    "kekulv/deepseek": "45m",
    "kekulv/grok": "10m"
  },
  "pi": {
    "subagent_extensions": []
  }
}
