{
  "defaultProvider": "kekulv",
  "defaultModel": "gemini-3.8-flash-high",
  "lastChangelogVersion": "0.87.0",
  "theme": "dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:@juicesharp/rpiv-todo",
      "extensions": []
    },
    "npm:pi-zentui",
    "npm:@czottmann/pi-automode",
    "git:github.com/NVlabs/SoL-Pi",
    {
      "source": "npm:@ff-labs/pi-fff",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:@cortexkit/pi-magic-context",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:@cortexkit/aft-pi",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-context-view",
    "npm:pi-rtk-optimizer",
    "npm:pi-better-btw-plus",
    "npm:pi-background-tasks"
  ],
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "kekulv/gpt-5.6-sol": "xhigh",
    "kekulv/gpt-5.6-luna": "medium",
    "kekulv/gpt-5.6-terra": "high",
    "kekulv/grok-4.6": "high",
    "kekulv/deepseek-flash": "high",
    "kekulv/gemini-3.8-flash-high": "high",
    "kekulv/claude-opus-5": "xhigh",
    "kekulv/claude-opus-4-8": "xhigh",
    "kekulv/claude-fable-5-1": "xhigh",
    "kekulv/gpt-6-astra": "xhigh",
    "kekulv/glm-5.3": "max",
    "kekulv/glm-5.3-flash": "high",
    "company/glm-5.3": "max",
    "company/glm-5.3-flash": "high"
  },
  "tuiMode": "regular",
  "terminal": {
    "showTerminalProgress": true
  },
  "showHardwareCursor": true,
  "showCacheMissNotices": true,
  "followUpMode": "one-at-a-time",
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "default"
}