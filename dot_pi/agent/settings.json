{
  "defaultProvider": "magpie",
  "defaultModel": "gemini-3.8-flash-high",
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:@juicesharp/rpiv-todo",
      "extensions": []
    },
    "npm:pi-zentui",
    "npm:@czottmann/pi-automode",
    "git:github.com/NVlabs/SoL-Pi",
    {
      "source": "npm:@ff-labs/pi-fff",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:@cortexkit/pi-magic-context",
      "extensions": [
        "+dist/index.js"
      ]
    },
    {
      "source": "npm:@cortexkit/aft-pi",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-context-view",
    "npm:pi-rtk-optimizer",
    "npm:@narumitw/pi-btw",
    "npm:pi-background-tasks",
    "npm:@hank-warren/pi-stats",
    "npm:pi-subagents",
    "npm:pi-sticky-model",
    "npm:pi-advisor-flow"
  ],
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "magpie/gpt-6-astra": "xhigh",
    "company/glm-5.3": "max",
    "company/glm-5.3-flash": "high",
    "magpie/gpt-5.6-sol": "xhigh",
    "magpie/gpt-5.6-luna": "low",
    "magpie/gpt-5.6-terra": "high",
    "magpie/gpt-6-sol": "xhigh",
    "magpie/gpt-6.1-sol": "xhigh",
    "magpie/gpt-6-luna": "low",
    "magpie/grok-4.6": "high",
    "magpie/grok-4.7": "high",
    "magpie/deepseek-flash": "high",
    "magpie/gemini-3.8-flash-high": "high",
    "magpie/claude-opus-5-5": "xhigh",
    "magpie/claude-opus-5": "xhigh",
    "magpie/claude-opus-4-8": "xhigh",
    "magpie/claude-fable-5-1": "xhigh",
    "magpie/glm-5.3": "max",
    "magpie/glm-5.3-flash": "high"
  },
  "tuiMode": "fullscreen",
  "terminal": {
    "showTerminalProgress": true
  },
  "showHardwareCursor": true,
  "cacheWarming": "idle",
  "showCacheMissNotices": true,
  "followUpMode": "one-at-a-time",
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "default"
}
