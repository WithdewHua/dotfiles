{
  "defaultProvider": "kekulv",
  "defaultModel": "deepseek-v4-flash",
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "packages": [
    "npm:pi-context-prune",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-zentui",
    "npm:@czottmann/pi-automode",
    "npm:pi-context",
    "git:github.com/NVlabs/SoL-Pi"
  ],
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "kekulv/gpt-5.6-sol": "xhigh",
    "kekulv/gpt-5.6-luna": "medium",
    "kekulv/gpt-5.6-terra": "high",
    "kekulv/grok-4.6": "high",
    "kekulv/deepseek-v4-flash": "high",
    "kekulv/claude-opus-5": "xhigh",
    "kekulv/claude-opus-4-8": "xhigh",
    "kekulv/claude-fable-5-1": "xhigh",
    "kekulv/gpt-6-astra": "xhigh",
    "kekulv/glm-5.3": "max"
  },
  "tuiMode": "regular",
  "terminal": {
    "showTerminalProgress": true
  },
  "showHardwareCursor": true,
  "showCacheMissNotices": true,
  "followUpMode": "one-at-a-time",
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "default"
}