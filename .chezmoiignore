{{/* The GPG-encrypted personal files this machine takes come from the "personal"
     multi-select in .chezmoi.yaml.tmpl, which lists the same paths as below. A config
     without "personal" manages none of them. */}}
{{- $personal := default (list) (get . "personal") -}}
README.md

{{ if not .is_desktop }}
.config/alacritty
.config/wezterm
.config/ghostty
{{ end }}

{{ if not .config_python_format_tools }}
.config/black
.config/flake8
.isort.cfg
{{ end }}

{{/* Windows always manages the Neovim config: the Windows package script installs
     Neovim during the same apply, so a lookPath check would skip the config on the
     very first run. */}}
{{ if and (ne .chezmoi.os "windows") (not (lookPath "nvim")) }}
.config/nvim
{{ end }}

{{ if not (stat (joinPath .chezmoi.homeDir ".atuin" "bin")) }}
.config/atuin
{{ end }}

{{ if not (has ".ssh" $personal) }}
.ssh
{{ end }}

{{ if not (has ".claude" $personal) }}
.claude
{{ end }}

{{/* GnuPG reads ~/.gnupg on macOS/Linux and %APPDATA%\gnupg on Windows: the agent
     options always go to the directory gpg actually uses. */}}
{{ if eq .chezmoi.os "windows" }}
.gnupg
{{ else }}
AppData
{{ end }}

{{ if not (lookPath "tmux") }}
.tmux.conf
{{ end }}

{{ if not (lookPath "pip3") }}
.pip
{{ end }}

{{ if not (lookPath "helix") }}
.config/helix
{{ end }}

{{/* The opencode config is encrypted and machine-local: only take it when it is
     selected and opencode is actually installed. */}}
{{- $hasOpenCode := or (stat (joinPath .chezmoi.homeDir ".opencode" "bin")) (lookPath "opencode") -}}
{{- if or (not (has ".config/opencode" $personal)) (not $hasOpenCode) }}
.config/opencode
{{- end }}

{{/* Windows is a partial target: only Neovim, Pi, Git, GnuPG, and the Python
     formatting configs are managed there. Everything below needs a POSIX shell, tmux,
     or a Unix terminal emulator, so it stays out of a Windows apply. */}}
{{- if eq .chezmoi.os "windows" }}
.zsh
.zshrc
.tmux.conf
.vimrc
.config/alacritty
.config/wezterm
.config/ghostty
.config/atuin
.config/starship.toml
{{- end }}

{{- $hasPiBin := or (stat (joinPath .chezmoi.homeDir ".local" "bin" "pi")) (stat (joinPath .chezmoi.homeDir ".pi" "agent" "bin" "pi")) (stat (joinPath .chezmoi.homeDir ".pi" "agent" "bin" "pi.cmd")) (stat "/usr/local/bin/pi") (stat "/opt/homebrew/bin/pi") -}}
{{- if and (not $hasPiBin) (not (lookPath "pi")) }}
.pi
{{- end }}

{{- if not (has ".pi/agent/models.json" $personal) }}
.pi/agent/models.json
{{- end }}

.pi/agent/sessions
.pi/agent/npm
.pi/agent/git
.pi/agent/bin
.pi/agent/install
.pi/agent/win-git-bash
.pi/agent/auth.json
.pi/agent/trust.json
.pi/agent/models-store.json
.pi/agent/model-specs-cache.json
.pi/agent/custom-providers.json
.pi/agent/pi-debug.log
.pi/agent/web-search-cache
.config/pi
