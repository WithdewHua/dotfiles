{{/* What this machine manages, from the single "profile" answer (see
     .chezmoi.yaml.tmpl): tools, providers, or all. A config without "profile" is
     treated as "tools", which manages the fewest files. */}}
{{- $profile := default "tools" (get . "profile") -}}
{{- $secrets := ne $profile "tools" -}}
{{- $keys := eq $profile "all" -}}
README.md

{{ if not .is_desktop }}
.config/alacritty
.config/wezterm
.config/ghostty
{{ end }}

{{ if not .config_python_format_tools }}
.config/black
.config/flake8
.isort.cfg
{{ end }}

{{/* Windows always manages the Neovim config: the Windows package script installs
     Neovim during the same apply, so a lookPath check would skip the config on the
     very first run. */}}
{{ if and (ne .chezmoi.os "windows") (not (lookPath "nvim")) }}
.config/nvim
{{ end }}

{{ if not (stat (joinPath .chezmoi.homeDir ".atuin" "bin")) }}
.config/atuin
{{ end }}

{{/* SSH keys, Claude settings, and opencode settings are machine-local: a second
     machine usually already has its own and applying these overwrites it, so they
     are only managed at the "all" level. */}}
{{ if not $keys }}
.ssh
.claude
{{ end }}

{{/* GnuPG reads ~/.gnupg on macOS/Linux and %APPDATA%\gnupg on Windows, so only the
     directory gpg actually uses is managed, and only once the secrets are unlocked. */}}
{{ if or (not $secrets) (eq .chezmoi.os "windows") }}
.gnupg
{{ end }}

{{ if or (not $secrets) (ne .chezmoi.os "windows") }}
AppData
{{ end }}

{{ if not (lookPath "tmux") }}
.tmux.conf
{{ end }}

{{ if not (lookPath "pip3") }}
.pip
{{ end }}

{{ if not (lookPath "helix") }}
.config/helix
{{ end }}

{{/* The opencode config is encrypted and machine-local, so it needs both the
     unlocked secrets and the explicit opt-in. */}}
{{- $hasOpenCode := or (stat (joinPath .chezmoi.homeDir ".opencode" "bin")) (lookPath "opencode") -}}
{{- if or (not $keys) (not $hasOpenCode) }}
.config/opencode
{{- end }}

{{/* Windows is a partial target: only Neovim, Pi, Git, GnuPG, and the Python
     formatting configs are managed there. Everything below needs a POSIX shell, tmux,
     or a Unix terminal emulator, so it stays out of a Windows apply. */}}
{{- if eq .chezmoi.os "windows" }}
.zsh
.zshrc
.tmux.conf
.vimrc
.config/alacritty
.config/wezterm
.config/ghostty
.config/atuin
.config/starship.toml
{{- end }}

{{- $hasPiBin := or (stat (joinPath .chezmoi.homeDir ".local" "bin" "pi")) (stat (joinPath .chezmoi.homeDir ".pi" "agent" "bin" "pi")) (stat (joinPath .chezmoi.homeDir ".pi" "agent" "bin" "pi.cmd")) (stat "/usr/local/bin/pi") (stat "/opt/homebrew/bin/pi") -}}
{{- if and (not $hasPiBin) (not (lookPath "pi")) }}
.pi
{{- end }}

{{- if not $secrets }}
.pi/agent/models.json
{{- end }}

.pi/agent/sessions
.pi/agent/npm
.pi/agent/git
.pi/agent/bin
.pi/agent/install
.pi/agent/win-git-bash
.pi/agent/auth.json
.pi/agent/trust.json
.pi/agent/models-store.json
.pi/agent/model-specs-cache.json
.pi/agent/custom-providers.json
.pi/agent/pi-debug.log
.pi/agent/web-search-cache
.config/pi
