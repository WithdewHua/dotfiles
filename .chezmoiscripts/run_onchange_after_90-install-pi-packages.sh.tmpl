{{- $hasPiBin := or (stat (joinPath .chezmoi.homeDir ".local" "bin" "pi")) (stat (joinPath .chezmoi.homeDir ".pi" "agent" "bin" "pi")) (stat "/usr/local/bin/pi") (stat "/opt/homebrew/bin/pi") -}}
{{- if and (ne .chezmoi.os "windows") (or $hasPiBin (lookPath "pi")) -}}
#!/usr/bin/env bash

set -eufo pipefail

# Re-run when the configured package list or any patch/sync script changes.
# packages: {{ (fromJson (includeTemplate "dot_pi/agent/settings.json.tmpl" .)).packages | toJson }}
# prune_hash: {{ include "dot_pi/agent/scripts/prune-pi-packages.mjs" | sha256sum }}
# hooks_hash: {{ include "dot_pi/agent/scripts/ensure-patch-hooks.mjs" | sha256sum }}
# patch_hash: {{ include "dot_pi/agent/scripts/patch-aft-pi.mjs" | sha256sum }}
# patch_fff_hash: {{ include "dot_pi/agent/scripts/patch-pi-fff.mjs" | sha256sum }}
# patch_automode_hash: {{ include "dot_pi/agent/scripts/patch-pi-automode.mjs" | sha256sum }}
# patch_advisor_flow_hash: {{ include "dot_pi/agent/scripts/patch-pi-advisor-flow.mjs" | sha256sum }}
# patch_magic_context_hash: {{ include "dot_pi/agent/scripts/patch-pi-magic-context.mjs" | sha256sum }}
# patch_all_hash: {{ include "dot_pi/agent/scripts/patch-all.mjs" | sha256sum }}

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
export NPM_CONFIG_ALLOW_REMOTE=all

PI_SCRIPTS_DIR="${HOME}/.pi/agent/scripts"

if ! command -v pi >/dev/null 2>&1; then
    echo "pi not found; skip package install" >&2
    exit 0
fi

# 1. Prune unneeded npm & git packages no longer listed in settings.json
node "${PI_SCRIPTS_DIR}/prune-pi-packages.mjs"

# 2. Ensure all configured packages are installed
packages=(
{{- range $pkg := (fromJson (includeTemplate "dot_pi/agent/settings.json.tmpl" .)).packages }}
{{-   $source := $pkg }}
{{-   if not (kindIs "string" $pkg) }}
{{-     $source = $pkg.source }}
{{-   end }}
    {{ $source | quote }}
{{- end }}
)

if (( ${#packages[@]} == 0 )); then
    exit 0
fi

for source in "${packages[@]}"; do
    pi install --no-approve "${source}"
done

# 3. Ensure auto-patch lifecycle hooks exist in npm/package.json
node "${PI_SCRIPTS_DIR}/ensure-patch-hooks.mjs"

# 4. Run automated patches
node "${PI_SCRIPTS_DIR}/patch-all.mjs"
{{- end -}}
