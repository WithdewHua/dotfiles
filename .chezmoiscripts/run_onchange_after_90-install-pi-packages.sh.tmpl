{{- $hasPiBin := or (stat (joinPath .chezmoi.homeDir ".local" "bin" "pi")) (stat "/usr/local/bin/pi") (stat "/opt/homebrew/bin/pi") -}}
{{- if or $hasPiBin (lookPath "pi") -}}
#!/usr/bin/env bash

set -eufo pipefail

# Re-run when the configured package list or the aft patch script changes.
# packages: {{ (fromJson (include "dot_pi/agent/settings.json")).packages | toJson }}
# patch_hash: {{ include "dot_pi/agent/scripts/patch-aft-pi.mjs" | sha256sum }}
# patch_fff_hash: {{ include "dot_pi/agent/scripts/patch-pi-fff.mjs" | sha256sum }}
# patch_all_hash: {{ include "dot_pi/agent/scripts/patch-all.mjs" | sha256sum }}

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
export NPM_CONFIG_ALLOW_REMOTE=all

if ! command -v pi >/dev/null 2>&1; then
    echo "pi not found; skip package install" >&2
    exit 0
fi

# 1. Prune unneeded npm & git packages no longer listed in settings.json
node --input-type=module -e '
import { readFileSync, existsSync, rmSync, readdirSync, statSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";
import { execSync } from "node:child_process";

const agentDir = join(homedir(), ".pi", "agent");
const settingsPath = join(agentDir, "settings.json");
if (!existsSync(settingsPath)) process.exit(0);

const settings = JSON.parse(readFileSync(settingsPath, "utf8"));
const configuredPackages = settings.packages || [];

// Prune unneeded npm packages
const npmDir = join(agentDir, "npm");
const npmPackageJsonPath = join(npmDir, "package.json");
if (existsSync(npmPackageJsonPath)) {
  const npmPkg = JSON.parse(readFileSync(npmPackageJsonPath, "utf8"));
  const installedDeps = Object.keys(npmPkg.dependencies || {});
  const configuredNpm = new Set();
  for (const p of configuredPackages) {
    const s = typeof p === "string" ? p : p.source;
    if (s.startsWith("npm:")) {
      let spec = s.slice(4);
      if (spec.startsWith("@")) {
        configuredNpm.add("@" + spec.slice(1).split("@")[0]);
      } else {
        configuredNpm.add(spec.split("@")[0]);
      }
    }
  }
  const toRemove = installedDeps.filter(d => !configuredNpm.has(d));
  for (const pkg of toRemove) {
    console.log(`[pi-packages] Pruning unneeded npm package: ${pkg}`);
    try {
      execSync(`npm rm ${pkg}`, { cwd: npmDir, stdio: "inherit" });
    } catch (e) {
      console.error(`[pi-packages] Failed to remove ${pkg}:`, e.message);
    }
  }
}

// Prune unneeded git packages
const gitDir = join(agentDir, "git");
if (existsSync(gitDir)) {
  const configuredGitPaths = new Set();
  for (const p of configuredPackages) {
    const s = typeof p === "string" ? p : p.source;
    if (s.startsWith("git:")) {
      let cleaned = s.slice(4).replace(/^https?:\/\//, "").replace(/\.git$/, "").split("@")[0];
      configuredGitPaths.add(cleaned.toLowerCase());
    }
  }
  try {
    for (const host of readdirSync(gitDir)) {
      const hostDir = join(gitDir, host);
      if (!statSync(hostDir).isDirectory()) continue;
      for (const owner of readdirSync(hostDir)) {
        const ownerDir = join(hostDir, owner);
        if (!statSync(ownerDir).isDirectory()) continue;
        for (const repo of readdirSync(ownerDir)) {
          const repoDir = join(ownerDir, repo);
          if (!statSync(repoDir).isDirectory()) continue;
          const repoPath = `${host}/${owner}/${repo}`.toLowerCase();
          if (!configuredGitPaths.has(repoPath)) {
            console.log(`[pi-packages] Pruning unneeded git package: ${host}/${owner}/${repo}`);
            rmSync(repoDir, { recursive: true, force: true });
          }
        }
      }
    }
  } catch (err) {
    console.error("[pi-packages] Git prune scan failed:", err.message);
  }
}
'

# 2. Ensure all configured packages are installed
packages=(
{{- range $pkg := (fromJson (include "dot_pi/agent/settings.json")).packages }}
{{-   $source := $pkg }}
{{-   if not (kindIs "string" $pkg) }}
{{-     $source = $pkg.source }}
{{-   end }}
    {{ $source | quote }}
{{- end }}
)

if (( ${#packages[@]} == 0 )); then
    exit 0
fi

for source in "${packages[@]}"; do
    pi install --no-approve "${source}"
done

# 3. Ensure postinstall hook exists in package.json for auto-patching on npm install/update
node --input-type=module -e '
import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";

const pkgPath = join(homedir(), ".pi", "agent", "npm", "package.json");
if (existsSync(pkgPath)) {
  const pkg = JSON.parse(readFileSync(pkgPath, "utf8"));
  pkg.scripts = pkg.scripts || {};
  let modified = false;
  if (pkg.scripts.postinstall !== "node ../scripts/patch-all.mjs") {
    pkg.scripts.postinstall = "node ../scripts/patch-all.mjs";
    modified = true;
  }
  if (pkg.scripts.patch !== "node ../scripts/patch-all.mjs") {
    pkg.scripts.patch = "node ../scripts/patch-all.mjs";
    modified = true;
  }
  if (modified) {
    writeFileSync(pkgPath, JSON.stringify(pkg, null, 2) + "\n", "utf8");
    console.log("[pi-packages] Configured auto-patch postinstall script in npm package.json");
  }
}
'

# 4. Run automated patches
node "${HOME}/.pi/agent/scripts/patch-all.mjs"
{{- end -}}
